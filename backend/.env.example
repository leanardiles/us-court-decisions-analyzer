# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Capstone I local app (not used for the Capstone II ingest store)
DATABASE_URL=sqlite:///./database.db

# Shared Capstone II store (Supabase)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Quote the password if it contains # $ &. Direct db.*.supabase.co often fails on IPv4;
# use the session pooler (us-east-2 for this project):
SUPABASE_DB_PASSWORD='your_database_password'
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT:URL_ENCODED_PASSWORD@aws-0-us-east-2.pooler.supabase.com:6543/postgres?sslmode=require

# Security
# SECRET_KEY=your-secret-key-here
